# Frontend environment variables for La Biblioteca.
#
# HOW TO USE (local development)
# --------------------------------
# You do NOT need this file for local development.
# Without it, the app defaults to http://localhost:8080 as the API base URL.
#
# To override (e.g. when pointing at a staging backend):
#   cp .env.example .env.local
#   Edit .env.local with your values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# HOW TO USE (production builds)
# --------------------------------
# VITE_API_BASE_URL is baked into the JS bundle at build time.
# Pass it as a build argument to Docker:
#
#   docker build \
#     --build-arg VITE_API_BASE_URL=https://api.yourdomain.com \
#     -t thelibrary:prod .
#
# Or via docker compose (see compose.prod.yaml):
#
#   VITE_API_BASE_URL=https://api.yourdomain.com \
#     docker compose -f compose.yaml -f compose.prod.yaml build frontend
#
# After changing this URL, also update the Content-Security-Policy connect-src
# directive in nginx.conf to allow the new API origin.

# Full URL of the Symfony backend API (no trailing slash).
# Default if not set: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
